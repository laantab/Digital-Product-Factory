# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Local application data and generated customer files
*.db
*.sqlite
*.sqlite3
exports/
uploads/
downloads/
instance/
logs/
*.log
*.pdf
*.zip

# Editor and OS files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Test output
test-results/
coverage.xml
junit.xml

# Bulk visual-swap image caches (94MB of PNGs)
_visual_swap_4249_candidates/
_visual_swap_4249_snapshot/

# Fonts. Anything copied in at runtime is a generated artifact and stays out of
# the repo, because we are not entitled to redistribute an arbitrary host face.
services/fonts/*.ttf
# Liberation Sans is the exception and MUST ship: it is the family embedded in
# every customer PDF, it is SIL OFL 1.1 licensed, and we are entitled to
# redistribute it. See services/fonts/FONT-PROVENANCE.md.
!services/fonts/LiberationSans-Regular.ttf
!services/fonts/LiberationSans-Bold.ttf
!services/fonts/LiberationSans-Italic.ttf
!services/fonts/LiberationSans-BoldItalic.ttf
!services/fonts/LiberationSerif-Regular.ttf
!services/fonts/LiberationSerif-Bold.ttf
!services/fonts/LiberationSerif-Italic.ttf
!services/fonts/LiberationSerif-BoldItalic.ttf

# SQLite write-ahead files
projects.db-shm
projects.db-wal
*.db-shm
*.db-wal

# Local recovery / scratch output, never part of the product
_backup_*/
overnight_work/
overnight_recovery_*/
.fuse_hidden*
