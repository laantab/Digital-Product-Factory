# Copy this file to .env and add real values only on your own computer.
# Never commit or upload .env.
SECRET_KEY=replace-with-a-long-random-value
OPENAI_API_KEY=
TAVILY_API_KEY=
PEXELS_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
FLASK_ENV=development

# --------------------------------------------------------------------------
# Factory AI: manuscript generation policy
#
# Opt-in and OFF by default everywhere, including your own computer -- an
# unset value means "use the paid cloud provider", never a local engine.
# Set this to local_first ONLY on a machine that actually runs Ollama
# (http://127.0.0.1:11434 by default). NEVER set this to local_first or
# local_only on a hosted deployment (Render or otherwise): there is no local
# engine there, and doing so would send every manuscript chapter attempt to
# an address that does not exist in that runtime.
#
# Valid values: local_first (try Ollama; a failure raises, it never silently
# falls back to a paid call), local_only, premium (cloud only -- the safe
# default). Leave this unset on every hosted deployment.
# --------------------------------------------------------------------------
FACTORY_AI_POLICY=

# --------------------------------------------------------------------------
# Billing
#
# Checkout stays switched off until these are filled in — the pricing page
# says so plainly rather than showing buttons that fail. See
# docs/BILLING_SETUP.md for the full walkthrough.
#
# You only need ONE provider. If both are configured, Stripe is used.
# --------------------------------------------------------------------------

# Public URL customers return to after paying (no trailing slash).
FACTORY_PUBLIC_URL=http://127.0.0.1:5000
FACTORY_BILLING_CURRENCY=usd
# Size of the founding cohort. Changing this after launch changes a public promise.
FACTORY_FOUNDER_SEATS=100

# --- Stripe ---------------------------------------------------------------
# Dashboard -> Developers -> API keys. Use sk_test_... until you are ready.
STRIPE_SECRET_KEY=
# Dashboard -> Developers -> Webhooks -> your endpoint -> signing secret.
# Endpoint URL: <FACTORY_PUBLIC_URL>/billing/webhook/stripe
# Events to send: checkout.session.completed, customer.subscription.updated,
#                 customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) created by scripts/setup_billing_products.py, or by
# hand in the Stripe dashboard. One per plan and billing period. All four
# plans are monthly-only right now — see services/billing/plans.py.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=

# --- Lemon Squeezy --------------------------------------------------------
# Settings -> API. Store id is the number in your store's dashboard URL.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Settings -> Webhooks -> signing secret.
# Endpoint URL: <FACTORY_PUBLIC_URL>/billing/webhook/lemonsqueezy
# Events: subscription_created, subscription_cancelled, subscription_expired,
#         subscription_payment_failed, subscription_resumed
LEMONSQUEEZY_WEBHOOK_SECRET=
# Variant ids (numbers), one per product built in the dashboard. STUDIO here
# is the "Agency" product — the internal plan id did not change, only the
# name shown to customers (services/billing/plans.py).
LEMONSQUEEZY_VARIANT_STARTER_MONTHLY=
LEMONSQUEEZY_VARIANT_FOUNDER_MONTHLY=
LEMONSQUEEZY_VARIANT_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_STUDIO_MONTHLY=

# --------------------------------------------------------------------------
# Private beta gate (2026-09-11)
#
# When set, EVERY route except /static/*, the billing webhooks and /invite
# requires this code (cookie, X-Factory-Invite header, or ?invite=CODE once).
# Set it on the HOST (Render -> Environment), not in this local .env, so the
# local Factory and the test suite stay open. Leave blank to switch it off.
# --------------------------------------------------------------------------
FACTORY_INVITE_CODE=

# --------------------------------------------------------------------------
# Object storage — Cloudflare R2 (Upgrade 0, Phase 0B-3B1)
#
# Selects where customer artifacts are stored. Leave FACTORY_STORAGE_DRIVER
# unset (or "local") and the Factory behaves exactly as it always has: PDFs
# on the local disk under exports/ and base64 inside projects.data.
#
# Set it to "r2" ONLY when all four R2 values below are present. Incomplete
# configuration raises on startup rather than quietly falling back — the same
# fail-closed rule that fixed the provider-routing defect in v1.7.8.
#
# Put the credentials on the HOST (Render -> Environment), never in a file
# that is committed. Scope the API token to this ONE bucket with Object Read
# & Write. The bucket MUST stay private: customer artifacts are served by
# Flask, never linked to directly, and these values never reach the browser.
# --------------------------------------------------------------------------
FACTORY_STORAGE_DRIVER=
# Endpoint is derived as https://<ACCOUNT_ID>.r2.cloudflarestorage.com
FACTORY_R2_ACCOUNT_ID=
FACTORY_R2_BUCKET=
FACTORY_R2_ACCESS_KEY_ID=
FACTORY_R2_SECRET_ACCESS_KEY=
# Optional. Region defaults to "auto" (what R2 expects); endpoint override
# is only for a non-standard R2 endpoint.
FACTORY_R2_REGION=
FACTORY_R2_ENDPOINT=
# Optional. Where the local driver keeps objects (default: exports/_assets).
FACTORY_STORAGE_DIR=
